---
const steps = [
  { fase: 'Onboarding', dono: 'Atendimento', desc: 'Cadastro do cliente, briefing 11+2 e perfil inicial automático.' },
  { fase: 'Estratégia', dono: 'Estrategista', desc: 'Business plan, metas e direção editorial por canal.' },
  { fase: 'Identidade', dono: 'Designer', desc: 'Assets e padrões visuais validados para execução.' },
  { fase: 'Planeamento', dono: 'Estrategista', desc: 'Campanhas, cadência, KPIs e datas definidas.' },
  { fase: 'Produção', dono: 'Conteúdo + Design', desc: 'Ângulos, copy, visual e subtarefas em fluxo.' },
  { fase: 'Aprovação', dono: 'Atendimento', desc: 'Gate final de qualidade e alinhamento com o cliente.' },
  { fase: 'Análise', dono: 'Estratégia + Conteúdo', desc: 'Performance, aprendizados e feedback loop.' },
];
---

<section class="py-24 px-6 bg-apex-dark" id="pipeline">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Pipeline de Operações Apex</h2>
      <p class="text-gray-400">Cada etapa tem dono, critérios e visibilidade para a equipa inteira.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {steps.map((s, i) => (
        <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-xl hover:border-apex-accent/50 transition-colors">
          <p class="text-xs font-mono text-apex-accent mb-2">0{i + 1}</p>
          <h3 class="text-xl font-semibold text-white">{s.fase}</h3>
          <p class="text-sm text-gray-500 mb-3">Liderança: {s.dono}</p>
          <p class="text-gray-400 text-sm leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
